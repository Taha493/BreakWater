# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Docker Compose only
POSTGRES_PASSWORD=

# Local runs default to SQLite; compose sets this to Postgres itself.
# GATEWAY_DATABASE_URL=sqlite:///./gateway.db

# Upstream LLM (OpenAI-compatible). Leave UPSTREAM_BASE_URL unset under Compose to use the
# dev mock upstream (localhost there is the gateway container). For a local run with the
# mock (uv run), uncomment it. With the mock, UPSTREAM_API_KEY can be any value.
# UPSTREAM_BASE_URL=http://localhost:9000/v1
UPSTREAM_API_KEY=
# UPSTREAM_TIMEOUT_SECONDS=60

# At least 32 characters. Changing it invalidates every API key and user hash.
GATEWAY_HASH_SECRET=
# At least 32 characters. Works only until the first admin key exists.
ADMIN_BOOTSTRAP_KEY=

# Rules are hot-reloaded from RULES_DIR. The policy lives in the database (edit it with
# PUT /admin/policies or the dashboard); POLICIES_PATH only seeds the first version.
# POLICIES_PATH=gateway/rules/policies.yaml
# RULES_DIR=gateway/rules
# CONFIG_RELOAD_SECONDS=2

# Layer 2, the injection classifier (ONNX model, CPU). Downloaded on first start (~740 MB)
# into the Hugging Face cache (HF_HOME), or fetch it ahead: uv run gateway classifier download
# CLASSIFIER_ENABLED=false
# CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2   # or a local directory
# CLASSIFIER_REVISION=90c9989b1a342275dd0d1a95aad283c04e075671
# CLASSIFIER_THREADS=2

# Layer 3, the LLM judge for borderline text. Choose the provider and model yourself:
#   anthropic          JUDGE_MODEL e.g. claude-haiku-5-5 (JUDGE_EFFORT=low keeps it fast)
#   groq, gemini       their OpenAI-compatible APIs; JUDGE_MODEL is their model id
#   openai_compatible  anything else with /chat/completions (set JUDGE_BASE_URL)
# JUDGE_ENABLED=false
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=
# JUDGE_API_KEY=
# JUDGE_BASE_URL=                       # required for openai_compatible; overrides the others
# JUDGE_EFFORT=low                      # anthropic models that support output_config.effort
# JUDGE_JSON_MODE=json_schema           # json_object for models without schema support
# JUDGE_MAX_TOKENS=2048

# STORE_FULL_TEXT=false
# MAX_BODY_BYTES=1048576
# STREAM_HOLDBACK_CHARS=200
# RETENTION_DAYS=30
# CORS_ORIGINS=http://localhost:8080   # the dashboard's origin (compose sets this)
# LOG_LEVEL=INFO

# Demo app (docker compose --profile demo). Its gateway client key; requests can also
# send it in an X-Gateway-Key header.
# DEMO_GATEWAY_KEY=
# DEMO_UPSTREAM_BASE_URL=http://mock_upstream:9000/v1
# The demo app's model: sim-obedient is the mock upstream's simulated model that follows
# injected instructions (the red-team target); mock-model only echoes.
# DEMO_MODEL=sim-obedient

# Red-team harness (gateway redteam run, /redteam/runs)
# REDTEAM_TARGETS_PATH=gateway/redteam/targets.yaml   # only targets with owned: true run
# REDTEAM_DEMO_URL=http://localhost:8100              # used by targets.yaml
# REDTEAM_GATEWAY_KEY=     # a client key for protected runs; unset: each run mints its own

# Dashboard (docker compose): the gateway URL as the browser reaches it
# DASHBOARD_GATEWAY_URL=http://localhost:8000
